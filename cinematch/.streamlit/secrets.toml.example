# For Streamlit Community Cloud: paste the lines below into  App settings -> Secrets  (NOT into GitHub).
# Root-level secrets become environment variables, which is how CineMatch reads them.
TMDB_API_KEY = "paste-your-tmdb-key-here"
# CINEMATCH_ENABLE_ADD = "1"   # uncomment to turn on the (built, but switched-off) "Add movie from TMDB" page
